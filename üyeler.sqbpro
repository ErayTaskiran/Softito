-- üye adı, kitap adı, gün sayısı 
SELECT u.ad AS uye_adi, k.ad AS kitap_adi, o.gun 
FROM odunc o
JOIN uyeler u ON o.uye_id = u.id
JOIN kitaplar k ON o.kitap_id = k.id;
 
 -- 30 günden uzun tutulan kitaplar
SELECT u.ad AS uye_adi, k.ad AS kitap_adi, o.gun 
FROM odunc o
JOIN uyeler u ON o.uye_id = u.id 
JOIN kitaplar k ON o.kitap_id = k.id 
WHERE o.gun &gt; 30;
-- sadece Erzincan üyeleri
SELECT u.ad AS uye_adi, k.ad AS kitap_adi, o.gun
FROM odunc o JOIN uyeler u ON o.uye_id = u.id
JOIN kitaplar k ON o.kitap_id = k.id
WHERE u.sehir = 'Erzincan';

-- ortalama süre, kitaap sayısı, maksimum süre
SELECT  u.id, u.ad, 
AVG(o.gun) AS ortalama_gun, 
COUNT(o.kitap_id) AS kitap_sayisi,
MAX(o.gun) AS en_uzun_sure 
FROM uyeler u 
JOIN odunc o ON u.id = o.uye_id
GROUP BY u.id, u.ad;

-- ortalama 20 günün üzerinde olanlar
SELECT u.ad, 
ROUND(AVG(o.gun), 2) AS ortalama_gun, 
COUNT(o.kitap_id) AS kitap_sayisi, 
MAX(o.gun) AS en_uzun_sure 
FROM uyeler u 
JOIN odunc o ON u.id = o.uye_id 
GROUP BY u.id, u.ad 
HAVING AVG(o.gun) &gt; 20;

-- her kitabın kaç kez ödünç alındığı
SELECT k.ad AS kitap_adi,
COUNT(o.uye_id) AS odunc_sayisi
FROM kitaplar k
JOIN odunc o ON k.id = o.kitap_id 
GROUP BY k.id, k.ad;
	
	-- şehirlere göre üye sayısı
SELECT sehir, 
COUNT(*) AS uye_sayisi 
FROM uyeler 
GROUP BY sehir 
ORDER BY uye_sayisi DESC;

-- kitabı 30 günden fazla tutanlar
SELECT ad FROM uyeler
 WHERE id IN (
 SELECT uye_id FROM odunc 
 WHERE gun &gt; 30 );

 -- ödünç alınmayan kitaplar
SELECT * FROM kitaplar WHERE id NOT IN ( SELECT kitap_id FROM odunc);	

--case ( ödünç kayıtları)
SELECT u.ad AS uye_adi, k.ad AS kitap_adi, o.gun,

    CASE
        WHEN o.gun &gt; 30 THEN 'Gecikmiş'
        WHEN o.gun BETWEEN 15 AND 30 THEN 'Uyarı'
        ELSE 'Normal'
    END AS durum

FROM odunc o
JOIN uyeler u ON o.uye_id = u.id
JOIN kitaplar k ON o.kitap_id = k.id;

-- üyeleri yaşlarına  göre
SELECT ad, yas,

    CASE
        WHEN yas &lt;= 18 THEN 'Genç'
        ELSE 'Yetişkin'
    END AS yas_grubu

FROM uyeler;

--ındex
CREATE INDEX idx_uyeler_ad ON uyeler(ad);
ALTER TABLE uyeler ADD COLUMN eposta TEXT;
CREATE UNIQUE INDEX idx_uyeler_eposta ON uyeler(eposta);

